# Store text with LF line endings so formatters and diffs agree on every platform.
* text=auto eol=lf

# Windows command scripts need CRLF to run.
*.cmd text eol=crlf
*.bat text eol=crlf

# The CLI's tests compare their output with these files byte for byte, so a checkout keeps their
# line endings and byte order marks as they are.
crates/cli/tests/goldens/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
