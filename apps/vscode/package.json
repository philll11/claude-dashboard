{
  "name": "agent-dashboard",
  "displayName": "Dashboard for Coding Agents",
  "description": "See how you use Claude Code and GitHub Copilot CLI: plan limits, usage, cost and where it goes.",
  "version": "2.0.0",
  "publisher": "philll11",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d0f12",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/philll11/agent-dashboard.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://github.com/philll11/agent-dashboard#readme",
  "bugs": {
    "url": "https://github.com/philll11/agent-dashboard/issues"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "usage",
    "cost",
    "tokens",
    "plan limits",
    "dashboard"
  ],
  "pricing": "Free",
  "private": true,
  "engines": {
    "vscode": "^1.126.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentDashboard.dashboard"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentDashboard.open",
        "title": "Open Dashboard",
        "category": "Dashboard for Coding Agents",
        "icon": "$(link-external)"
      },
      {
        "command": "agentDashboard.openInEditor",
        "title": "Open in Editor",
        "category": "Dashboard for Coding Agents",
        "icon": "$(link-external)"
      },
      {
        "command": "agentDashboard.refresh",
        "title": "Read New Activity",
        "category": "Dashboard for Coding Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "agentDashboard.connectLimits",
        "title": "Connect Plan Limits",
        "category": "Dashboard for Coding Agents"
      },
      {
        "command": "agentDashboard.importHistory",
        "title": "Bring In History from claude-usage",
        "category": "Dashboard for Coding Agents"
      },
      {
        "command": "agentDashboard.chooseFolders",
        "title": "Choose Data Folders",
        "category": "Dashboard for Coding Agents"
      },
      {
        "command": "agentDashboard.showLog",
        "title": "Show Log",
        "category": "Dashboard for Coding Agents"
      },
      {
        "command": "agentDashboard.restart",
        "title": "Restart agent-dashboard",
        "category": "Dashboard for Coding Agents"
      },
      {
        "command": "agentDashboard.show",
        "title": "Show Section",
        "category": "Dashboard for Coding Agents"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentDashboard.show",
          "when": "false"
        },
        {
          "command": "agentDashboard.openInEditor",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentDashboard.refresh",
          "when": "view == agentDashboard.summary",
          "group": "navigation@1"
        },
        {
          "command": "agentDashboard.open",
          "when": "view == agentDashboard.summary",
          "group": "navigation@2"
        },
        {
          "command": "agentDashboard.refresh",
          "when": "view == agentDashboard.view",
          "group": "navigation@1"
        },
        {
          "command": "agentDashboard.openInEditor",
          "when": "view == agentDashboard.view",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentDashboard",
          "title": "Dashboard for Coding Agents",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "agentDashboardUsage",
          "title": "Usage dashboard",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentDashboard": [
        {
          "id": "agentDashboard.summary",
          "name": "Dashboard for Coding Agents",
          "contextualTitle": "Dashboard for Coding Agents",
          "icon": "media/activity.svg"
        }
      ],
      "agentDashboardUsage": [
        {
          "type": "webview",
          "id": "agentDashboard.view",
          "name": "Usage dashboard",
          "contextualTitle": "Dashboard for Coding Agents",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentDashboard.summary",
        "contents": "Reading your history…",
        "when": "agentDashboard.state == starting"
      },
      {
        "view": "agentDashboard.summary",
        "contents": "agent-dashboard has stopped, so the dashboard cannot show your usage.\n[Restart agent-dashboard](command:agentDashboard.restart)\n[Show the log](command:agentDashboard.showLog)",
        "when": "agentDashboard.state == stopped"
      },
      {
        "view": "agentDashboard.summary",
        "contents": "The extension has no agent-dashboard program for this platform. Set agentDashboard.server.path to one, such as a build from the GitHub release.\n[Open the setting](command:workbench.action.openSettings?%22agentDashboard.server.path%22)",
        "when": "agentDashboard.state == noProgram"
      }
    ],
    "configuration": {
      "title": "Dashboard for Coding Agents",
      "properties": {
        "agentDashboard.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `agent-dashboard` program to run instead of the one that comes with the extension, such as a build of your own. Leave it empty to use the one that comes with the extension."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Dashboard for Coding Agents",
        "description": "Record your plan limits, bring in older history, and choose where Claude Code and Copilot CLI keep their data.",
        "steps": [
          {
            "id": "connectLimits",
            "title": "Record your plan limits",
            "description": "Claude Code passes your plan limits to its status line. Connect agent-dashboard's status line to record them; the dashboard shows the change to Claude Code's settings before making it, and you can undo it.\n[Connect plan limits](command:agentDashboard.connectLimits)",
            "media": {
              "markdown": "media/walkthrough/limits.md"
            },
            "completionEvents": [
              "onContext:agentDashboard.limitsConnected"
            ]
          },
          {
            "id": "importHistory",
            "title": "Bring in your claude-usage history",
            "description": "If you used the claude-usage dashboard, it kept requests that Claude Code has since deleted. Bring them into your history once.\n[Bring in history](command:agentDashboard.importHistory)",
            "media": {
              "markdown": "media/walkthrough/import.md"
            },
            "when": "agentDashboard.importOffered",
            "completionEvents": [
              "onCommand:agentDashboard.importHistory"
            ]
          },
          {
            "id": "chooseFolders",
            "title": "Choose your data folders",
            "description": "agent-dashboard reads the folders where Claude Code and Copilot CLI keep their data. Add any other, such as an agent's folder in WSL.\n[Choose data folders](command:agentDashboard.chooseFolders)",
            "media": {
              "markdown": "media/walkthrough/folders.md"
            },
            "completionEvents": [
              "onCommand:agentDashboard.chooseFolders"
            ]
          },
          {
            "id": "openDashboard",
            "title": "Open the dashboard",
            "description": "See where your usage goes: sessions, projects, models and limits.\n[Open the dashboard](command:agentDashboard.open)",
            "media": {
              "markdown": "media/walkthrough/dashboard.md"
            },
            "completionEvents": [
              "onCommand:agentDashboard.open"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project .",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs --tests && vscode-test",
    "test:e2e": "node scripts/e2e.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@agent-dashboard/app": "workspace:*",
    "@agent-dashboard/protocol": "workspace:*",
    "vscode-jsonrpc": "10.0.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "vitest": "5.0.5",
    "vscode-extension-tester": "8.28.1"
  }
}
