{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the dashboard in the main window may ask of the app: the server's answers, its notifications, the window's theme, a folder picker, Show in folder and updates.",
  "windows": ["main"],
  "permissions": [
    "allow-request",
    "allow-take-show",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-theme",
    "core:window:allow-show",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart"
  ]
}
