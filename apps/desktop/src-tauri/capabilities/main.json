{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the dashboard in the main window may ask of the app: the server's answers, its notifications, the window's theme and colour, a folder picker, Show in folder, exports through the app's own save dialog, the notification area, opening at login and updates.",
  "windows": ["main"],
  "permissions": [
    "allow-request",
    "allow-take-show",
    "allow-ready",
    "allow-desktop",
    "allow-close-choice",
    "allow-update-waiting",
    "allow-autostart",
    "allow-set-autostart",
    "allow-export",
    "allow-export-cancel",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-theme",
    "core:window:allow-set-background-color",
    "core:webview:allow-set-webview-background-color",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart"
  ]
}
