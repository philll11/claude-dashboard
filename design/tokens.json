  "vscode": {
    "page": "var(--vscode-editor-background)",
    "panel": "var(--vscode-sideBar-background, var(--vscode-editor-background))",
    "line": "var(--vscode-panel-border, var(--vscode-widget-border))",
    "grid": "color-mix(in srgb, var(--vscode-foreground) 8%, var(--panel))",
    "axis": "color-mix(in srgb, var(--vscode-foreground) 20%, var(--panel))",
    "ink": "var(--vscode-foreground)",
    "ink-2": "var(--vscode-foreground)",
    "muted": "var(--vscode-descriptionForeground)",
    "meter": "var(--vscode-progressBar-background)",
    "selected": "var(--vscode-button-background)",
    "selected-ink": "var(--vscode-button-foreground)",
    "track": "color-mix(in srgb, var(--vscode-foreground) 10%, var(--panel))",
    "bar": "color-mix(in srgb, var(--vscode-foreground) 55%, var(--panel))",
    "bar-track": "color-mix(in srgb, var(--vscode-foreground) 6%, var(--panel))",
    "tip-bg": "var(--vscode-editorHoverWidget-background)",
    "tip-line": "var(--vscode-editorHoverWidget-border)",
    "warning-icon": "var(--vscode-editorWarning-foreground)",
    "spark": "var(--bar)",
    "indicator": "var(--vscode-panelTitle-activeBorder)"
  },
  "terminal": {
