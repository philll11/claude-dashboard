  "vscode-high-contrast": {
    "grid": "color-mix(in srgb, var(--vscode-foreground) 23%, var(--panel))",
    "axis": "var(--vscode-foreground)",
    "track": "var(--page)",
    "bar": "var(--vscode-foreground)",
    "bar-track": "var(--page)",
    "indicator": "var(--vscode-contrastActiveBorder)",
    "selected-outline": "1px solid var(--vscode-contrastActiveBorder)",
    "track-outline": "1px solid var(--vscode-foreground)",
    "swatch-outline": "1px solid var(--vscode-foreground)"
  },
  "vscode-view": {
    "page": "transparent",
    "panel": "color-mix(in srgb, var(--vscode-foreground) 4%, transparent)"
  },
  "vscode-view-high-contrast": {
    "panel": "transparent"
  },
  "vscode-series": "follows the theme kind: dark and high contrast use the dark series, light and high contrast light use the light series"
