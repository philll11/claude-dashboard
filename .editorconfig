root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

# Exports as they are written, byte for byte, carriage returns and all.
[crates/cli/tests/goldens/**]
insert_final_newline = unset
trim_trailing_whitespace = false
